pipeline {
    agent any

    environment {
        IMAGE_NAME = 'portfolio-website'
        IMAGE_REPO = 'aksshan/portfolio-website'
    }

    options {
        timeout(time: 15, unit: 'MINUTES')
        disableConcurrentBuilds()
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
                sh 'ls -la'
                echo "Checked out commit ${env.GIT_COMMIT}"
            }
        }

        stage('Build') {
            steps {
                sh "docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} ."
            }
        }

        stage('Tag') {
            steps {
                sh """
                    docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_REPO}:${BUILD_NUMBER}
                    docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_REPO}:latest
                    docker images | grep ${IMAGE_NAME}
                """
            }
        }

        stage('Docker Hub Login') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'dockerhub-creds',
                    usernameVariable: 'DH_USER',
                    passwordVariable: 'DH_TOKEN')]) {
                    sh 'echo "$DH_TOKEN" | docker login -u "$DH_USER" --password-stdin'
                }
            }
        }

        stage('Push') {
            steps {
                sh """
                    docker push ${IMAGE_REPO}:${BUILD_NUMBER}
                    docker push ${IMAGE_REPO}:latest
                """
            }
        }
    }

    post {
        always {
            sh 'docker logout || true'
            // cleanWs() was removed here so your pipeline doesn't crash
        }
        success {
            echo "Published ${IMAGE_REPO}:${BUILD_NUMBER} and :latest"
            echo "Deployment is manual and is NOT performed by this pipeline."
        }
        failure {
            echo "Pipeline failed. No image was published."
        }
    }
}